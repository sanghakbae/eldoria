rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsCharacter(characterId) {
      return signedIn()
        && get(/databases/$(database)/documents/characters/$(characterId)).data.ownerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    match /characters/{characterId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;

      match /{collection}/{document=**} {
        allow read: if ownsCharacter(characterId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
