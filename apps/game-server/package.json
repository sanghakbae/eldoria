{
  "name": "@eldoria/game-server",
  "version": "0.0.0",
  "private": true,
  "description": "Eldoria authoritative real-time game server.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ../../tools/create-local-firebase-adc.mjs && GOOGLE_APPLICATION_CREDENTIALS=/tmp/eldoria-firebase-adc.json tsx watch src/main.ts",
    "seed:foods": "node ../../tools/create-local-firebase-adc.mjs && GOOGLE_APPLICATION_CREDENTIALS=/tmp/eldoria-firebase-adc.json tsx src/seed-food-catalog.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@eldoria/game-protocol": "workspace:*",
    "@eldoria/game-data": "workspace:*",
    "firebase-admin": "catalog:",
    "jose": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
